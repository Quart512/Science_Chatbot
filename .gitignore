# chroma_db/
chroma_db/

# SQLite 데이터 디렉터리(6-4, 07-31) — 체크포인트 DB(orchestrator.py의 CHECKPOINT_DB_PATH)
# + 나중에 추가될 앱 데이터 RDB(관심사·실험도구, RoadMap "VDB vs RDB" 참고). 디렉터리
# 단위로 제외해두면 앱 DB 파일이 생겨도 이 파일을 다시 안 고쳐도 됨.
data/

# 논문·노트 원본 파일(08-05, "논문 파일 경로 추적 재설계" 착수 ①) — 사용자가 직접
# 넣는 PDF·문서라 git에 올라가면 안 된다(용량·저작권 둘 다).
library/

